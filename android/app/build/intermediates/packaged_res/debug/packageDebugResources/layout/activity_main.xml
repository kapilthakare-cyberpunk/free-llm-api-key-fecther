<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LLM Key Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Provider"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Key"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/keysContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <Button
        android:id="@+id/addKeyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Key Manually"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/pasteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paste from Clipboard"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/exportButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Backup"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/telegramButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Backup to Telegram"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/driveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backup to Google Drive"
        android:layout_marginTop="8dp"/>

</LinearLayout>
